{
  "$schema": "design-tokens BLACKVAULT « Signal souverain » v1.0",
  "color": {
    "ground": {
      "bg": "#070B10",
      "bg-alt": "#0B121A",
      "surface": "#101923",
      "surface-2": "#152231"
    },
    "line": {
      "default": "#1E2C3A",
      "strong": "#2A3B4D"
    },
    "text": {
      "ink": "#E6EDF4",
      "ink-2": "#B8C3CF",
      "muted": "#93A3B5",
      "subtle (sombre uniquement)": "#6A7B8D"
    },
    "accent": {
      "default (texte AA sur sombre)": "#2485D0",
      "logo (UI, fonds clairs)": "#1F74B5",
      "soft (liens, labels, AAA)": "#5EAAE3",
      "tint": "rgba(36, 133, 208, .12)",
      "line": "rgba(94, 170, 227, .38)"
    },
    "semantic": {
      "signal (état d'alerte réel)": "#F2B138",
      "error (formulaires)": "#F2767A"
    }
  },
  "font": {
    "sans": "\"Sora\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "weights": {
      "Sora": [
        400,
        500,
        600
      ],
      "IBM Plex Mono": [
        500
      ]
    },
    "subsets": [
      "latin",
      "latin-ext"
    ],
    "license": "OFL-1.1"
  },
  "size": {
    "display": "clamp(2.5rem, 1.75rem + 3.4vw, 4.5rem)",
    "h1": "clamp(2.25rem, 1.7rem + 2.4vw, 3.5rem)",
    "h2": "clamp(1.75rem, 1.35rem + 1.8vw, 2.625rem)",
    "h3": "clamp(1.25rem, 1.15rem + .45vw, 1.5rem)",
    "h4": "clamp(1.0625rem, 1.03rem + .15vw, 1.125rem)",
    "lead": "clamp(1.0625rem, 1rem + .35vw, 1.25rem)",
    "body": "clamp(1rem, .96rem + .15vw, 1.0625rem)",
    "small": ".9375rem",
    "label": ".8125rem",
    "stat": "clamp(2.5rem, 2rem + 2.2vw, 3.5rem)"
  },
  "space": {
    "base": "8px",
    "s1": "8px",
    "s2": "16px",
    "s3": "24px",
    "s4": "32px",
    "s6": "48px",
    "s8": "64px",
    "s12": "96px",
    "section": "clamp(72px, 48px + 6vw, 128px)"
  },
  "radius": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px"
  },
  "motion": {
    "ease": "cubic-bezier(.2, .7, .2, 1)",
    "fast": "150ms",
    "default": "240ms",
    "slow": "400ms",
    "reduced-motion": "tout coupé"
  },
  "contrast (vérifié)": {
    "ink / bg": "16,71:1",
    "muted / bg": "7,65:1",
    "muted / surface": "6,87:1",
    "accent / bg": "5,02:1",
    "accent / surface": "4,51:1",
    "accent-soft / surface": "7,03:1",
    "accent-logo / blanc": "4,97:1"
  },
  "elementor-kit-mapping": {
    "primary": "#2485D0",
    "secondary": "#5EAAE3",
    "accent": "#5EAAE3",
    "text (sections claires basculées)": "#93A3B5",
    "produits bv*": "#5EAAE3",
    "typographies": "Sora (toutes) ; bvlabel = IBM Plex Mono"
  }
}